   "source": [
    "lst = [i for i in range(200)]\n",
    "#chunk_size = int(input(\"Enter chunk size\"))\n",
    "\n",
    "def data_loader(chunk_size, lst):\n",
    "    for i in range(0,len(lst), chunk_size):\n",
    "        yield lst[i:i+chunk_size]\n",
    "\n",
    "x = data_loader(10, lst)\n",
    "\n",
    "print(next(x))\n",
    "print(next(x))\n",
    "print(next(x))\n",
    "print(next(x)) \n",
    "\n",
    "\n"
   ]
  }
